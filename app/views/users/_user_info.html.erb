<head>
  <link rel="stylesheet" type="text/css" href="my.css">
</head>

<div class="continer">
  <div class="head">
    <h2>
      <%= user.name %>さんのマイページ
    </h2>
  </div>

  <div class="follow">
    <%= render "relationships/relationship_button", followed: user %><br>
    <%= link_to "フォローしているユーザー", followings_user_path(user) %><br>
    <%= link_to "フォロワー", followers_user_path(user) %><br>
    <%= link_to "お気に入りの投稿", favorites_user_path(user) %><br>
    <%= link_to "投稿一覧", user %>
  </div>
</div>