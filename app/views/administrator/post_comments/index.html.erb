<h1>コメント一覧</h1>

<table class="table table-bordered">
  <thead class="thead-dark">
    <tr>
      <th>id</th>
      <th>名前</th>
      <th>コメント</th>
      <th>登録日</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @post_comments.each do |post_comment| %>
      <tr>
        <td><%= post_comment.id %></td>
        <td><%= post_comment.user.name %></td>
        <td><%= post_comment.comment %></td>
        <td><%= l post_comment.created_at  %></td>
        <td>
          <%= link_to "destroy", administrator_post_comment_path(post_comment),
                                 method: :delete,
                                 data: { confirm: "本当に削除しますか" },
                                 class: "btn btn-outline-danger" %>
        </td>
      </tr>
    <% end %>
  <tbody>
</table>