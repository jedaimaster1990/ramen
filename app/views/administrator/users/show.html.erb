<h1>投稿者</h1>

<div class="row">
  <div class="col-md-4">
    <table class="table">
      <tbody>
        <tr>
          <th>id</th>
          <td><%= @user.id %></td>
        </tr>
        <tr>
          <th>名前</th>
          <td><%= @user.name %></td>
        </tr>
        <tr>
          <th>email</th>
          <td></td>
        </tr>
      </tbody>
    </table>

    <%= link_to "destroy", administrator_user_path(@user),
                                 method: :delete,
                                 data: { confirm: "本当に削除しますか" },
                                 class: "btn btn-outline-danger" %>
  </div>
  <div class="col-md-8">
    <%= render "administrator/post_images/post_images", post_images: @post_images %>
  </div>
</div>