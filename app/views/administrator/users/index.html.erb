<h1>投稿者</h1>

<table class="table table-bordered">
  <thead class="thead-dark">
    <tr>
      <th>id</th>
      <th>名前</th>
      <th>email</th>
      <th>登録日</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= l user.created_at  %></td>
        <td>
          <%= link_to "show", administrator_user_path(user),
                              class: "btn btn-outline-primary" %>
        </td>
      </tr>
    <% end %>
  <tbody>
</table>